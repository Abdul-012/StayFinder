<% layout('layouts/boilerplate') -%>

    <h1>This Is Travel Website</h1>

    <br>

        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% for (let listing of listings) { %>
                    <div class="card col listing-card">
                        <!-- Link around image -->
                        <a href="/listings/<%= listing._id %>">
                            <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=60' %>" class="card-img-top" alt="<%= listing.title %>" />
                        </a>

                        <div class="card-body">
                            <!-- Title -->
                            <p class="card-text">
                                <a href="/listings/<%= listing._id %>">
                                    <%= listing.title %>
                                </a>
                            </p>
                            <!-- Price -->
                            <p><strong>Price:</strong> $<%= listing.price %></p>
                        </div>
                    </div>
                <% } %>
        </div>
